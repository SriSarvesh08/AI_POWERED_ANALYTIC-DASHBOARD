# ── DataPilot AI — Backend Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your values
# NEVER commit the actual .env to source control

# App security
SECRET_KEY=your-strong-random-secret-key-here           # generate: openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL (data warehouse + pipeline state)
DATABASE_URL=postgresql+asyncpg://datapilot:datapilot@postgres:5432/datapilot

# PostgreSQL (auth — can be same DB or a separate one)
AUTH_DATABASE_URL=postgresql+asyncpg://datapilot:datapilot@postgres:5432/datapilot_auth

# Gemini AI  (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Apache Superset
SUPERSET_BASE_URL=http://superset:8088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_SECRET_KEY=your-strong-superset-secret-key     # generate: openssl rand -hex 32

# CORS — add your frontend URL(s) here
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost"]

# File uploads
UPLOAD_DIR=/tmp/datapilot/uploads
MAX_UPLOAD_SIZE_MB=100

# Groq (optional fallback AI)  (https://console.groq.com)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
USE_GROQ=True
