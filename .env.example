# ── DataPilot AI — Root Environment Variables ─────────────────────────────────
# This file is the canonical reference for all environment variables.
# Copy to .env and fill in your values. NEVER commit .env to source control.

# ── Gemini AI ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ── Groq (optional fallback) ───────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# ── App Secrets ────────────────────────────────────────────────────────────────
SECRET_KEY=your-strong-random-secret-key      # openssl rand -hex 32
SUPERSET_SECRET_KEY=your-superset-secret-key  # openssl rand -hex 32

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=datapilot
POSTGRES_PASSWORD=datapilot
POSTGRES_DB=datapilot

# ── Superset ───────────────────────────────────────────────────────────────────
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
